---
import Layout from '../layouts/Layout.astro';

export const prerender = true;

const canonicalUrl = new URL('/kanter-ball', import.meta.env.PUBLIC_SITE_URL ?? 'https://sportykore.com').href;

const gameSchema = {
	'@context': 'https://schema.org',
	'@type': 'VideoGame',
	name: 'Sportykore Kanter Ball',
	description:
		'A mobile-first 7v7 bottle-cap football game from Sportykore. Flick, take turns, beat the computer, and share your result.',
	url: canonicalUrl,
	applicationCategory: 'Game',
	operatingSystem: 'Web browser',
	publisher: {
		'@type': 'Organization',
		name: 'Sportykore',
	},
};
---

<Layout
	title="Sportykore Kanter Ball | 7v7 Bottle-Cap Football Game"
	description="Play Sportykore Kanter Ball, a mobile 7v7 bottle-cap football web demo against the computer. Pick a difficulty, flick your caps, and share the result."
	pathname="/kanter-ball"
	ogImageAlt="Sportykore Kanter Ball - a 7v7 bottle-cap football match against the computer."
	structuredData={[gameSchema]}
>
	<main id="main" class="kanter-page bg-pitch text-white">
		<section class="kanter-hero bg-stripe-hero px-4 pb-8 pt-6 sm:px-8 lg:pb-12 lg:pt-10">
			<div class="mx-auto grid max-w-6xl gap-6 lg:grid-cols-[0.68fr_1.32fr] lg:items-center">
				<div class="kanter-intro space-y-5">
					<p class="eyebrow text-gold-soft">Sunday street-game test</p>
					<h1 class="display-1 text-balance">Sportykore Kanter Ball</h1>
					<p class="max-w-xl text-[1.0625rem] leading-relaxed text-white/76">
						Pick a difficulty, flick your 7 caps, and beat the computer before the
						owner of the ball collects it.
					</p>
					<div class="flex flex-wrap gap-3 text-sm font-bold text-white/76">
						<span class="kanter-pill">7v7 turns</span>
						<span class="kanter-pill">90 active seconds</span>
						<span class="kanter-pill">First to 3</span>
					</div>
				</div>

				<section class="kanter-shell" aria-label="Kanter Ball game">
					<div class="kanter-scorebar" aria-live="polite">
						<div>
							<p class="kanter-score-label">You</p>
							<strong data-player-score>0</strong>
						</div>
						<div>
							<p class="kanter-score-label">CPU</p>
							<strong data-cpu-score>0</strong>
						</div>
						<div>
							<p class="kanter-score-label">Time</p>
							<strong><span data-time>90</span>s</strong>
						</div>
						<div>
							<p class="kanter-score-label">Record</p>
							<strong data-record>0</strong>
						</div>
						<button class="kanter-icon-button" type="button" data-mute aria-pressed="false">
							<span data-mute-label>Sound on</span>
						</button>
					</div>

					<div class="kanter-meta">
						<span data-turn-pill>Your turn</span>
						<span data-difficulty-pill>Medium</span>
						<span data-rules-pill>Football rules</span>
						<span data-owner-pill>Owner calm</span>
					</div>

					<div class="kanter-game-wrap" data-game-wrap>
						<canvas
							id="kanter-canvas"
							class="kanter-canvas"
							width="720"
							height="980"
							aria-label="Top-down Kanter Ball 7v7 pitch"
						></canvas>
						<div class="kanter-toast" data-toast aria-live="polite"></div>
						<div class="kanter-flash" data-flash></div>

						<div class="kanter-overlay is-visible" data-start-overlay>
							<div class="kanter-overlay-card">
								<p class="wordmark text-3xl text-gold-score">Sportykore</p>
								<p class="eyebrow mt-3 text-gold-soft">Kanter Ball</p>
								<h2>Pick your level</h2>
								<p>
									Select a cap, drag back, and release. You and the computer take
									one flick at a time.
								</p>
								<div class="kanter-option-label">Game rules</div>
								<div class="kanter-rules" role="group" aria-label="Choose match rules">
									<button type="button" data-rules="football" class="is-active">
										<span>Football</span>
										<small>Throw-ins, corners and goal kicks</small>
									</button>
									<button type="button" data-rules="street">
										<span>Street</span>
										<small>Walls rebound the ball</small>
									</button>
								</div>
								<div class="kanter-option-label">Difficulty</div>
								<div class="kanter-difficulty" role="group" aria-label="Choose difficulty">
									<button type="button" data-difficulty="easy">Easy</button>
									<button type="button" data-difficulty="medium" class="is-active">Medium</button>
									<button type="button" data-difficulty="hard">Hard</button>
								</div>
								<button type="button" class="btn-cta" data-start>Play Football · Medium</button>
							</div>
						</div>

						<div class="kanter-overlay" data-end-overlay>
							<div class="kanter-overlay-card">
								<p class="eyebrow text-gold-soft" data-end-kicker>Full time</p>
								<h2 data-end-title>Draw game</h2>
								<p data-end-copy>0-0 on Medium.</p>
								<div class="kanter-end-actions">
									<button type="button" class="btn-cta" data-share>Share result</button>
									<button type="button" class="btn-ghost-dark" data-rematch>Choose next match</button>
								</div>
								<a
									class="kanter-follow-link"
									href="https://x.com/sportykore"
									target="_blank"
									rel="noopener noreferrer"
									data-follow-x
								>
									Follow Sportykore on X
								</a>
							</div>
						</div>
					</div>

					<p class="kanter-help">
						Owner hits count only when your flick hits the gold owner cap without
						touching the ball or scoring.
					</p>
				</section>
			</div>
		</section>
	</main>
</Layout>

<style>
	.kanter-page {
		min-height: 100vh;
		overflow-x: clip;
	}

	.kanter-hero {
		min-height: calc(100vh - 4.5rem);
	}

	.kanter-hero > div,
	.kanter-hero > div > * {
		min-width: 0;
	}

	.kanter-hero h1,
	.kanter-hero p {
		overflow-wrap: anywhere;
	}

	.kanter-intro {
		order: 2;
	}

	.kanter-pill {
		border: 1px solid rgba(248, 248, 250, 0.18);
		border-radius: 999px;
		background: rgba(248, 248, 250, 0.06);
		padding: 0.45rem 0.75rem;
	}

	.kanter-shell {
		margin-inline: auto;
		width: 100%;
		max-width: 37rem;
		min-width: 0;
		order: 1;
	}

	.kanter-scorebar {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.5rem;
		margin-bottom: 0.65rem;
	}

	.kanter-scorebar > div,
	.kanter-icon-button {
		min-width: 0;
		border: 1px solid rgba(248, 248, 250, 0.14);
		border-radius: 14px;
		background: rgba(18, 18, 18, 0.72);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.22);
		padding: 0.5rem 0.55rem;
	}

	.kanter-scorebar strong {
		display: block;
		color: var(--score-gold);
		font-family: var(--font-playfair);
		font-size: 1.35rem;
		line-height: 1;
	}

	.kanter-score-label {
		margin: 0 0 0.25rem;
		color: rgba(248, 248, 250, 0.62);
		font-size: 0.66rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.kanter-icon-button {
		grid-column: 1 / -1;
		color: #ffffff;
		font-size: 0.75rem;
		font-weight: 800;
	}

	.kanter-meta {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.5rem;
		margin-bottom: 0.65rem;
	}

	.kanter-meta span {
		border: 1px solid rgba(248, 248, 250, 0.12);
		border-radius: 999px;
		background: rgba(18, 18, 18, 0.62);
		color: rgba(248, 248, 250, 0.76);
		font-size: 0.76rem;
		font-weight: 800;
		padding: 0.45rem 0.65rem;
		text-align: center;
	}

	.kanter-game-wrap {
		position: relative;
		overflow: hidden;
		width: 100%;
		border: 1px solid rgba(248, 248, 250, 0.14);
		border-radius: 22px;
		background:
			radial-gradient(circle at 50% 0%, rgba(230, 168, 23, 0.14), transparent 22%),
			linear-gradient(180deg, #1e7a40, #14552e);
		box-shadow: var(--shadow-phone);
		touch-action: none;
	}

	.kanter-canvas {
		display: block;
		width: 100%;
		aspect-ratio: 36 / 49;
	}

	.kanter-toast {
		position: absolute;
		left: 50%;
		top: 0.85rem;
		z-index: 3;
		max-width: calc(100% - 1.5rem);
		transform: translate(-50%, -0.5rem);
		border: 1px solid rgba(248, 248, 250, 0.16);
		border-radius: 999px;
		background: rgba(18, 18, 18, 0.88);
		color: var(--gold-soft);
		font-size: 0.8rem;
		font-weight: 800;
		opacity: 0;
		padding: 0.5rem 0.8rem;
		pointer-events: none;
		text-align: center;
		transition:
			opacity 0.2s ease,
			transform 0.2s ease;
	}

	.kanter-toast.is-visible {
		opacity: 1;
		transform: translate(-50%, 0);
	}

	.kanter-flash {
		position: absolute;
		inset: 0;
		background: rgba(230, 168, 23, 0.22);
		opacity: 0;
		pointer-events: none;
	}

	.kanter-flash.is-active {
		animation: kanter-flash 0.45s ease-out;
	}

	.kanter-overlay {
		position: absolute;
		inset: 0;
		z-index: 4;
		display: none;
		align-items: flex-start;
		justify-content: center;
		background: rgba(18, 18, 18, 0.74);
		padding: 8% 1rem 1rem;
	}

	.kanter-overlay.is-visible {
		display: flex;
	}

	.kanter-overlay-card {
		width: min(100%, 22rem);
		border: 1px solid rgba(248, 248, 250, 0.16);
		border-radius: 18px;
		background: rgba(18, 18, 18, 0.94);
		box-shadow: 0 22px 55px rgba(0, 0, 0, 0.34);
		padding: 1.15rem;
		text-align: center;
	}

	.kanter-overlay-card h2 {
		margin: 0.35rem 0 0;
		font-family: var(--font-playfair);
		font-size: clamp(2rem, 1.35rem + 4vw, 3rem);
		line-height: 1.05;
	}

	.kanter-overlay-card p:not(.eyebrow):not(.wordmark) {
		margin: 0.8rem auto 1.1rem;
		color: rgba(248, 248, 250, 0.74);
		line-height: 1.55;
	}

	.kanter-difficulty,
	.kanter-rules {
		display: grid;
		gap: 0.45rem;
		margin: 0 0 1rem;
	}

	.kanter-difficulty {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.kanter-rules {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.kanter-option-label {
		margin: 0 0 0.45rem;
		color: rgba(248, 248, 250, 0.62);
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-align: left;
		text-transform: uppercase;
	}

	.kanter-difficulty button,
	.kanter-rules button {
		border: 1px solid rgba(248, 248, 250, 0.18);
		border-radius: 999px;
		background: rgba(248, 248, 250, 0.07);
		color: #ffffff;
		font-size: 0.78rem;
		font-weight: 800;
		padding: 0.58rem 0.5rem;
	}

	.kanter-difficulty button.is-active,
	.kanter-rules button.is-active {
		border-color: var(--cta-gold);
		background: var(--cta-gold);
		color: #171717;
	}

	.kanter-rules button {
		display: flex;
		min-height: 4.15rem;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		line-height: 1.2;
	}

	.kanter-rules button small {
		margin-top: 0.25rem;
		color: rgba(248, 248, 250, 0.58);
		font-size: 0.62rem;
		font-weight: 600;
	}

	.kanter-rules button.is-active small {
		color: rgba(23, 23, 23, 0.72);
	}

	.kanter-end-actions {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.kanter-follow-link {
		display: inline-block;
		margin-top: 1rem;
		color: var(--gold-soft);
		font-weight: 800;
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}

	.kanter-help {
		margin: 0.8rem 0 0;
		color: rgba(248, 248, 250, 0.62);
		font-size: 0.82rem;
		line-height: 1.55;
		text-align: center;
	}

	@keyframes kanter-flash {
		0% {
			opacity: 0;
		}
		35% {
			opacity: 1;
		}
		100% {
			opacity: 0;
		}
	}

	@media (min-width: 640px) {
		.kanter-scorebar {
			grid-template-columns: repeat(4, minmax(0, 1fr)) auto;
		}

		.kanter-icon-button {
			grid-column: auto;
			min-width: 4.8rem;
		}

		.kanter-meta {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.kanter-overlay {
			align-items: center;
			padding: 1rem;
		}

		.kanter-end-actions {
			flex-direction: row;
			justify-content: center;
		}
	}

	@media (min-width: 1024px) {
		.kanter-intro,
		.kanter-shell {
			order: initial;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.kanter-toast,
		.kanter-flash,
		.btn-cta,
		.btn-ghost-dark {
			animation: none;
			transition: none;
		}
	}
</style>

<script>
import { planCpuTurn } from '../lib/kanter-ball/cpu.js';
import {
	isBallInKeeperDanger,
	isKeeperRecoveryFlick,
	nextKeeperRecoveryPosition,
} from '../lib/kanter-ball/keeper.js';
import { OWNER_COMMENTARY, ownerReaction, OWNER_LIMITS } from '../lib/kanter-ball/owner.js';
import { advanceMatchClock, MATCH_PACING } from '../lib/kanter-ball/pacing.js';
import {
	detectBoundaryEvent,
	goalKickKeeperPositions,
	insetPitch,
	isBallEnteringGoal,
	restartPlacement,
	shouldRecordLastTouch,
} from '../lib/kanter-ball/boundaries.js';

(() => {
	const canvas = document.getElementById('kanter-canvas');
	if (!(canvas instanceof HTMLCanvasElement)) return;

	const ctx = canvas.getContext('2d');
	if (!ctx) return;

	const playerScoreEl = document.querySelector('[data-player-score]');
	const cpuScoreEl = document.querySelector('[data-cpu-score]');
	const timeEl = document.querySelector('[data-time]');
	const recordEl = document.querySelector('[data-record]');
	const turnPill = document.querySelector('[data-turn-pill]');
	const difficultyPill = document.querySelector('[data-difficulty-pill]');
	const rulesPill = document.querySelector('[data-rules-pill]');
	const ownerPill = document.querySelector('[data-owner-pill]');
	const startOverlay = document.querySelector('[data-start-overlay]');
	const endOverlay = document.querySelector('[data-end-overlay]');
	const startButton = document.querySelector('[data-start]');
	const rematchButton = document.querySelector('[data-rematch]');
	const shareButton = document.querySelector('[data-share]');
	const muteButton = document.querySelector('[data-mute]');
	const muteLabel = document.querySelector('[data-mute-label]');
	const toastEl = document.querySelector('[data-toast]');
	const flashEl = document.querySelector('[data-flash]');
	const endKicker = document.querySelector('[data-end-kicker]');
	const endTitle = document.querySelector('[data-end-title]');
	const endCopy = document.querySelector('[data-end-copy]');
	const followLink = document.querySelector('[data-follow-x]');
	const difficultyButtons = Array.from(document.querySelectorAll('[data-difficulty]'));
	const rulesButtons = Array.from(document.querySelectorAll('[data-rules]'));

	const MUTE_KEY = 'sportykore:kanter-ball:mute';
	const RECORDS_KEY = 'sportykore:kanter-ball:records';
	const MATCH_SECONDS = 90;
	const GOAL_TARGET = 3;
	const WORLD = { width: 720, height: 980 };
	const PITCH = { x: 48, y: 58, width: 624, height: 864 };
	const FIELD_INSET = 28;
	const FIELD = insetPitch(PITCH, FIELD_INSET);
	const GOAL = { width: 186, depth: 34 };
	const PHYSICS = {
		friction: 410,
		maxDrag: 125,
		powerScale: 7.6,
		cpuPowerScale: 6.6,
		restitution: 0.72,
		wallRestitution: 0.56,
		restSpeed: 10,
	};
	const DIFFICULTIES = {
		easy: {
			label: 'Easy',
		},
		medium: {
			label: 'Medium',
		},
		hard: {
			label: 'Hard',
		},
	};
	const COMMENTARY = {
		kickoff: { lines: ['Make we start!', 'Game don start oo'], clips: [] },
		goal: { lines: ['Goooal!', 'Na goal be that!', 'Sweet finish!'], clips: [] },
		near_miss: { lines: ['Ah! Close one', 'Bad luck'], clips: [] },
		save: { lines: ['Keeper save am!', 'No entry!'], clips: [] },
		owner_1: { lines: [OWNER_COMMENTARY.owner_1], clips: ['/audio/kanter-ball/owner-alert.m4a'] },
		owner_2: { lines: [OWNER_COMMENTARY.owner_2], clips: ['/audio/kanter-ball/owner-warning.m4a'] },
		owner_vex: { lines: [OWNER_COMMENTARY.owner_vex], clips: ['/audio/kanter-ball/owner-vexed.m4a'] },
		owner_warn: { lines: [OWNER_COMMENTARY.owner_warn], clips: [] },
		owner_collect: { lines: [OWNER_COMMENTARY.owner_collect], clips: ['/audio/kanter-ball/owner-collect.m4a'] },
		time_low: { lines: ['Time dey go oo!'], clips: ['/audio/kanter-ball/clock-running-down.m4a'] },
		full_time: { lines: ['Time up! Good game'], clips: ['/audio/kanter-ball/match-ends.m4a'] },
	};
	const AMBIENCE = {
		url: '',
		volume: 0.25,
	};

	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const state = {
		mode: 'ready',
		difficulty: 'medium',
		rulesMode: 'football',
		turn: 'player',
		playerScore: 0,
		cpuScore: 0,
		remaining: MATCH_SECONDS,
		startedAt: 0,
		lastFrame: performance.now(),
		timeLowSpoken: false,
		ownerHits: 0,
		records: readRecords(),
		muted: readMuted(),
		audioReady: false,
		selectedCap: null,
		dragging: false,
		dragPoint: null,
		settleTimer: 0,
		cpuThinkTimer: 0,
		toastTimer: 0,
		goalCooldown: 0,
		currentShot: null,
		lastTouch: null,
		restartTaker: null,
		particles: [],
		audio: {
			ctx: null,
			ambience: null,
			ambienceGain: null,
			ambienceAudio: null,
			commentaryAudio: null,
			duckTimer: 0,
		},
	};

	let ball = makeBody({ type: 'ball', side: 'neutral', x: 360, y: 490, r: 14, mass: 0.7, color: '#F8F8FA' });
	let playerCaps = [];
	let cpuCaps = [];
	let bodies = [];

	updateHud();
	resize();
	resetPositions('player');
	requestAnimationFrame(loop);

	window.addEventListener('resize', resize);
	startButton?.addEventListener('click', startGame);
	rematchButton?.addEventListener('click', () => {
		track('change_match_click', currentResultData());
		showMatchSetup();
	});
	shareButton?.addEventListener('click', shareResult);
	followLink?.addEventListener('click', () => track('waitlist_click', { target: 'x', ...currentResultData() }));
	muteButton?.addEventListener('click', toggleMute);
	for (const button of difficultyButtons) {
		button.addEventListener('click', () => setDifficulty(button.getAttribute('data-difficulty') || 'medium'));
	}
	for (const button of rulesButtons) {
		button.addEventListener('click', () => setRulesMode(button.getAttribute('data-rules') || 'football'));
	}

	canvas.addEventListener('pointerdown', onPointerDown);
	canvas.addEventListener('pointermove', onPointerMove);
	canvas.addEventListener('pointerup', onPointerUp);
	canvas.addEventListener('pointercancel', cancelDrag);
	canvas.addEventListener('touchstart', onTouchStart, { passive: false });
	canvas.addEventListener('touchmove', onTouchMove, { passive: false });
	canvas.addEventListener('touchend', onTouchEnd, { passive: false });
	canvas.addEventListener('touchcancel', cancelDrag);
	canvas.addEventListener('mousedown', onMouseDown);
	canvas.addEventListener('mousemove', onMouseMove);
	canvas.addEventListener('mouseup', onMouseUp);
	canvas.addEventListener('mouseleave', onMouseLeave);

	function makeBody({ type, side, role = 'outfield', x, y, r, mass, color, owner = false }) {
		return {
			type,
			side,
			role,
			x,
			y,
			vx: 0,
			vy: 0,
			r,
			mass,
			color,
			owner,
		};
	}

	function resize() {
		const rect = canvas.getBoundingClientRect();
		const dpr = Math.min(window.devicePixelRatio || 1, 2);
		canvas.width = Math.max(1, Math.round(rect.width * dpr));
		canvas.height = Math.max(1, Math.round(rect.height * dpr));
		ctx.setTransform(canvas.width / WORLD.width, 0, 0, canvas.height / WORLD.height, 0, 0);
	}

	function setDifficulty(key) {
		if (!DIFFICULTIES[key]) return;
		state.difficulty = key;
		for (const button of difficultyButtons) {
			button.classList.toggle('is-active', button.getAttribute('data-difficulty') === key);
		}
		updateHud();
	}

	function setRulesMode(key) {
		if (key !== 'football' && key !== 'street') return;
		state.rulesMode = key;
		for (const button of rulesButtons) {
			button.classList.toggle('is-active', button.getAttribute('data-rules') === key);
		}
		updateHud();
	}

	function showMatchSetup() {
		state.mode = 'ready';
		state.dragging = false;
		state.selectedCap = null;
		state.currentShot = null;
		endOverlay?.classList.remove('is-visible');
		startOverlay?.classList.add('is-visible');
		updateHud();
	}

	function startGame() {
		unlockAudio();
		state.mode = 'running';
		state.turn = 'player';
		state.playerScore = 0;
		state.cpuScore = 0;
		state.remaining = MATCH_SECONDS;
		state.startedAt = performance.now();
		state.timeLowSpoken = false;
		state.ownerHits = 0;
		state.selectedCap = null;
		state.dragging = false;
		state.dragPoint = null;
		state.settleTimer = 0;
		state.cpuThinkTimer = 0;
		state.goalCooldown = 0;
		state.lastTouch = null;
		state.restartTaker = null;
		state.particles = [];
		startOverlay?.classList.remove('is-visible');
		endOverlay?.classList.remove('is-visible');
		resetPositions('player');
		showToast('Your turn. Drag one red cap.');
		playCommentary('kickoff');
		track('game_start', { difficulty: difficultyLabel(), rules: state.rulesMode });
		updateHud();
	}

	function endGame(reason = 'full_time') {
		if (state.mode === 'ended') return;
		state.mode = 'ended';
		state.dragging = false;
		state.selectedCap = null;
		const result = getResult(reason);
		updateRecords(result);
		if (endKicker) {
			endKicker.textContent = reason === 'owner_collect' ? 'Owner collected the ball' : result.kicker;
		}
		if (endTitle) endTitle.textContent = result.title;
		if (endCopy) {
			endCopy.textContent = `${state.playerScore}-${state.cpuScore} · ${rulesLabel()} · ${difficultyLabel()}. Best streak: ${state.records.bestStreak}.`;
		}
		endOverlay?.classList.add('is-visible');
		playCommentary(reason === 'owner_collect' ? 'owner_collect' : 'full_time');
		track('game_end', currentResultData(reason));
		updateHud();
	}

	function getResult(reason) {
		if (reason === 'owner_collect') {
			return { result: 'loss', kicker: 'Owner collected the ball', title: 'Owner don collect am' };
		}
		if (state.playerScore > state.cpuScore) return { result: 'win', kicker: 'You win', title: 'You beat the computer' };
		if (state.playerScore < state.cpuScore) return { result: 'loss', kicker: 'Computer wins', title: 'Computer took it' };
		return { result: 'draw', kicker: 'Full time', title: 'Draw game' };
	}

	function currentResultData(reason = state.mode === 'ended' ? 'ended' : 'in_progress') {
		const result = getResult(reason).result;
		return {
			result,
			playerScore: state.playerScore,
			cpuScore: state.cpuScore,
			difficulty: difficultyLabel(),
			rules: state.rulesMode,
			duration: Math.max(0, Math.round((performance.now() - state.startedAt) / 1000)),
			reason,
		};
	}

	function updateRecords(result) {
		if (result.result === 'win') {
			state.records.currentStreak += 1;
			state.records.bestStreak = Math.max(state.records.bestStreak, state.records.currentStreak);
			state.records.wins[state.difficulty] = (state.records.wins[state.difficulty] || 0) + 1;
		} else {
			state.records.currentStreak = 0;
			if (result.result === 'draw') state.records.draws += 1;
			if (result.result === 'loss') state.records.losses += 1;
		}
		writeRecords(state.records);
	}

	function resetPositions(nextTurn = 'player') {
		ball = makeBody({ type: 'ball', side: 'neutral', x: 360, y: 490, r: 14, mass: 0.7, color: '#F8F8FA' });
		playerCaps = [
			makeBody({ type: 'cap', side: 'player', role: 'keeper', x: 360, y: 865, r: 25, mass: 1.8, color: '#E53935' }),
			makeBody({ type: 'cap', side: 'player', x: 215, y: 770, r: 24, mass: 1.6, color: '#E53935' }),
			makeBody({ type: 'cap', side: 'player', x: 505, y: 770, r: 24, mass: 1.6, color: '#E53935' }),
			makeBody({ type: 'cap', side: 'player', x: 280, y: 675, r: 24, mass: 1.6, color: '#E53935' }),
			makeBody({ type: 'cap', side: 'player', x: 440, y: 675, r: 24, mass: 1.6, color: '#E53935' }),
			makeBody({ type: 'cap', side: 'player', x: 220, y: 585, r: 24, mass: 1.6, color: '#E53935' }),
			makeBody({ type: 'cap', side: 'player', x: 500, y: 585, r: 24, mass: 1.6, color: '#E53935' }),
		];
		cpuCaps = [
			makeBody({ type: 'cap', side: 'cpu', role: 'keeper', x: 360, y: 115, r: 25, mass: 1.8, color: '#4A148C' }),
			makeBody({ type: 'cap', side: 'cpu', x: 215, y: 210, r: 24, mass: 1.6, color: '#4A148C' }),
			makeBody({ type: 'cap', side: 'cpu', x: 505, y: 210, r: 24, mass: 1.6, color: '#4A148C' }),
			makeBody({ type: 'cap', side: 'cpu', x: 280, y: 305, r: 24, mass: 1.6, color: '#4A148C', owner: true }),
			makeBody({ type: 'cap', side: 'cpu', x: 440, y: 305, r: 24, mass: 1.6, color: '#4A148C' }),
			makeBody({ type: 'cap', side: 'cpu', x: 220, y: 395, r: 24, mass: 1.6, color: '#4A148C' }),
			makeBody({ type: 'cap', side: 'cpu', x: 500, y: 395, r: 24, mass: 1.6, color: '#4A148C' }),
		];
		bodies = [ball, ...playerCaps, ...cpuCaps];
		state.turn = nextTurn;
		state.selectedCap = null;
		state.dragging = false;
		state.dragPoint = null;
		state.currentShot = null;
		state.lastTouch = null;
		state.restartTaker = null;
		state.settleTimer = 0;
		state.cpuThinkTimer = 0;
	}

	function onPointerDown(event) {
		beginDrag(eventPoint(event));
		try {
			canvas.setPointerCapture(event.pointerId);
		} catch {
			// Pointer capture is unavailable in a few synthetic input paths.
		}
	}

	function onPointerMove(event) {
		if (!state.dragging) return;
		state.dragPoint = eventPoint(event);
	}

	function onPointerUp(event) {
		if (!state.dragging) return;
		releaseDrag(eventPoint(event));
	}

	function onTouchStart(event) {
		const touch = event.changedTouches[0];
		if (!touch) return;
		event.preventDefault();
		beginDrag(eventPoint(touch));
	}

	function onTouchMove(event) {
		if (!state.dragging) return;
		const touch = event.changedTouches[0];
		if (!touch) return;
		event.preventDefault();
		state.dragPoint = eventPoint(touch);
	}

	function onTouchEnd(event) {
		if (!state.dragging) return;
		const touch = event.changedTouches[0];
		if (!touch) return;
		event.preventDefault();
		releaseDrag(eventPoint(touch));
	}

	function onMouseDown(event) {
		beginDrag(eventPoint(event));
	}

	function onMouseMove(event) {
		if (!state.dragging) return;
		state.dragPoint = eventPoint(event);
	}

	function onMouseUp(event) {
		if (!state.dragging) return;
		releaseDrag(eventPoint(event));
	}

	function onMouseLeave() {
		cancelDrag();
	}

	function beginDrag(point) {
		if (state.mode !== 'running' || state.turn !== 'player' || !isSettled()) return false;
		const cap = playerCaps.find((item) => distance(point, item) <= item.r + 18);
		if (!cap) return false;
		state.selectedCap = cap;
		state.dragging = true;
		state.dragPoint = point;
		return true;
	}

	function releaseDrag(point) {
		const cap = state.selectedCap;
		if (!cap) return;
		const drag = clampVector({ x: cap.x - point.x, y: cap.y - point.y }, PHYSICS.maxDrag);
		cancelDrag();
		if (Math.hypot(drag.x, drag.y) < 10) return;
		if (
			state.rulesMode === 'football' &&
			cap.role === 'keeper' &&
			cap !== state.restartTaker &&
			!isBallInKeeperDanger({ side: 'player', ball, pitch: FIELD }) &&
			!isKeeperRecoveryFlick({ keeper: cap, movement: drag, side: 'player', pitch: FIELD, ballRadius: ball.r })
		) {
			showToast('Keeper can only move back toward goal while the ball is safe.');
			return;
		}
		cap.vx = drag.x * PHYSICS.powerScale;
		cap.vy = drag.y * PHYSICS.powerScale;
		state.restartTaker = null;
		state.currentShot = {
			side: 'player',
			cap,
			touchedBall: false,
			touchedOwner: false,
			scored: false,
			ownerWarned: false,
		};
		state.turn = 'settling';
		state.settleTimer = 0;
		showToast('Shot away.');
		updateHud();
	}

	function cancelDrag() {
		state.dragging = false;
		state.dragPoint = null;
	}

	function loop(now) {
		const dt = Math.min((now - state.lastFrame) / 1000, 0.033);
		state.lastFrame = now;
		if (state.mode === 'running') tickRun(dt);
		tickAudio(dt);
		draw();
		requestAnimationFrame(loop);
	}

	function tickRun(dt) {
		const clock = advanceMatchClock({
			remaining: state.remaining,
			dt,
			turn: state.turn,
			goalCooldown: state.goalCooldown,
		});
		state.remaining = clock.remaining;
		if (state.remaining <= 10 && !state.timeLowSpoken) {
			state.timeLowSpoken = true;
			playCommentary('time_low');
		}
		if (clock.shouldEnd) {
			endGame('full_time');
			return;
		}
		if (state.goalCooldown > 0) {
			state.goalCooldown -= dt;
			updateHud();
			return;
		}

		stepPhysics(dt);
		updateParticles(dt);
		updateCpu(dt);
		updateTurnAfterSettle(dt);

		if (state.toastTimer > 0) {
			state.toastTimer -= dt;
			if (state.toastTimer <= 0) toastEl?.classList.remove('is-visible');
		}

		updateHud();
	}

	function updateCpu(dt) {
		if (state.turn !== 'cpu' || !isSettled()) return;
		state.cpuThinkTimer += dt;
		if (state.cpuThinkTimer < MATCH_PACING.cpuThinkDelay) return;
		state.cpuThinkTimer = 0;
		cpuShoot();
	}

	function updateTurnAfterSettle(dt) {
		if (state.turn !== 'settling' || !isSettled()) return;
		state.settleTimer += dt;
		if (state.settleTimer < MATCH_PACING.settleDelay) return;
		resolveShot();
	}

	function cpuShoot() {
		if (state.restartTaker?.side === 'cpu') {
			const cap = state.restartTaker;
			const direction = normalize({ x: ball.x - cap.x, y: ball.y - cap.y });
			cap.vx = direction.x * 520;
			cap.vy = direction.y * 520;
			state.restartTaker = null;
			beginCpuShot(cap);
			return;
		}
		const plan = planCpuTurn({
			ball,
			cpuCaps,
			playerCaps,
			difficulty: state.difficulty,
			pitch: FIELD,
			goal: GOAL,
			friction: PHYSICS.friction,
			maxDrag: PHYSICS.maxDrag,
			powerScale: PHYSICS.cpuPowerScale,
		});
		if (!plan) return;
		const cap = plan.cap;
		cap.vx = plan.velocity.x;
		cap.vy = plan.velocity.y;
		beginCpuShot(cap);
	}

	function beginCpuShot(cap) {
		state.currentShot = {
			side: 'cpu',
			cap,
			touchedBall: false,
			touchedOwner: false,
			scored: false,
			ownerWarned: false,
		};
		state.turn = 'settling';
		state.settleTimer = 0;
		showToast('Computer flicks.');
	}

	function resolveShot() {
		const shot = state.currentShot;
		if (!shot) return;
		if (shot.side === 'player' && shot.touchedOwner && !shot.touchedBall && !shot.scored) {
			handleOwnerHit();
		} else if (!shot.scored && shot.touchedBall && Math.random() < 0.12) {
			playCommentary('near_miss');
		}
		recoverKeepers();
		state.currentShot = null;
		state.selectedCap = null;
		state.turn = shot.side === 'player' ? 'cpu' : 'player';
		state.settleTimer = 0;
		if (state.mode === 'running') {
			showToast(state.turn === 'player' ? 'Your turn.' : 'Computer turn.');
		}
	}

	function recoverKeepers() {
		if (state.rulesMode !== 'football' || state.mode !== 'running') return;
		for (const keeper of [
			playerCaps.find((cap) => cap.role === 'keeper'),
			cpuCaps.find((cap) => cap.role === 'keeper'),
		].filter(Boolean)) {
			const candidate = nextKeeperRecoveryPosition({ keeper, side: keeper.side, ball, pitch: FIELD });
			if (!candidate.moved) continue;
			const blocked = bodies.some(
				(body) =>
					body !== keeper &&
					Math.hypot(body.x - candidate.x, body.y - candidate.y) < body.r + keeper.r + 4
			);
			if (blocked) continue;
			keeper.x = candidate.x;
			keeper.y = candidate.y;
		}
	}

	function handleOwnerHit() {
		state.ownerHits += 1;
		const reaction = ownerReaction(state.ownerHits);
		if (reaction.stage === 'collect') {
			showToast('owner don collect him ball');
			track('owner_collect', currentResultData('owner_collect'));
			endGame('owner_collect');
			return;
		}
		if (reaction.stage === 'vexed') {
			showToast('owner of the ball don dey vex o');
			playCommentary(reaction.commentary);
			return;
		}
		if (reaction.stage === 'warning') {
			showToast('na him be owner of the ball o — him go collect am');
			playCommentary(reaction.commentary);
			return;
		}
		showToast('no vex the owner of the ball oo');
		playCommentary(reaction.commentary);
	}

	function stepPhysics(dt) {
		const previousBall = { x: ball.x, y: ball.y };
		for (const body of bodies) {
			body.x += body.vx * dt;
			body.y += body.vy * dt;
			applyFriction(body, dt);
		}

		for (const body of bodies) {
			if (state.rulesMode === 'street' || body !== ball) collideWalls(body);
		}
		if (state.rulesMode === 'football') {
			const boundaryEvent = detectBoundaryEvent({
				previous: previousBall,
				ball,
				pitch: FIELD,
				goal: GOAL,
				lastTouch: state.lastTouch,
				fallbackTouch: state.currentShot?.side,
			});
			if (boundaryEvent) {
				handleBoundaryEvent(boundaryEvent);
				return;
			}
		}
		for (let i = 0; i < bodies.length; i += 1) {
			for (let j = i + 1; j < bodies.length; j += 1) collideBodies(bodies[i], bodies[j]);
		}
		if (state.rulesMode === 'street') checkGoal();
	}

	function handleBoundaryEvent(event) {
		if (event.type === 'goal') {
			scoreGoal(event.awardedTo);
			return;
		}
		for (const body of bodies) {
			body.vx = 0;
			body.vy = 0;
		}
		const teamCaps = event.awardedTo === 'player' ? playerCaps : cpuCaps;
		const placement = restartPlacement({ event, pitch: FIELD, ballRadius: ball.r });
		const eligible =
			placement.role === 'keeper'
				? teamCaps.filter((cap) => cap.role === 'keeper')
				: teamCaps.filter((cap) => cap.role !== 'keeper');
		let taker = closestTo(eligible.length ? eligible : teamCaps, placement.taker);
		ball.x = placement.ball.x;
		ball.y = placement.ball.y;
		if (event.type === 'goal_kick') {
			const keeperPositions = goalKickKeeperPositions({
				event,
				pitch: FIELD,
				ballRadius: ball.r,
				capRadius: 25,
			});
			const playerKeeper = playerCaps.find((cap) => cap.role === 'keeper');
			const cpuKeeper = cpuCaps.find((cap) => cap.role === 'keeper');
			if (playerKeeper) Object.assign(playerKeeper, keeperPositions.player);
			if (cpuKeeper) Object.assign(cpuKeeper, keeperPositions.cpu);
			taker = event.awardedTo === 'player' ? playerKeeper || taker : cpuKeeper || taker;
			clearGoalKickSpace([playerKeeper, cpuKeeper].filter(Boolean));
		} else {
			taker.x = placement.taker.x;
			taker.y = placement.taker.y;
		}
		state.currentShot = null;
		state.selectedCap = null;
		state.restartTaker = taker;
		state.lastTouch = null;
		state.turn = event.awardedTo;
		state.settleTimer = 0;
		state.cpuThinkTimer = 0;
		const team = event.awardedTo === 'player' ? 'Your' : 'Computer';
		const label =
			event.type === 'throw_in' ? 'throw-in' : event.type === 'goal_kick' ? 'goal kick' : 'corner';
		showToast(`${team} ${label}.`);
		track('restart_awarded', { type: event.type, side: event.awardedTo, rules: state.rulesMode });
	}

	function clearGoalKickSpace(keepers) {
		const anchors = [ball, ...keepers];
		for (const cap of [...playerCaps, ...cpuCaps]) {
			if (cap.role === 'keeper') continue;
			for (const anchor of anchors) {
				const minimumDistance = cap.r + anchor.r + 8;
				let dx = cap.x - anchor.x;
				let dy = cap.y - anchor.y;
				let currentDistance = Math.hypot(dx, dy);
				if (currentDistance >= minimumDistance) continue;
				if (currentDistance < 0.001) {
					dx = cap.x <= FIELD.x + FIELD.width / 2 ? -1 : 1;
					dy = cap.side === 'player' ? -1 : 1;
					currentDistance = Math.hypot(dx, dy);
				}
				cap.x = Math.min(
					FIELD.x + FIELD.width - cap.r,
					Math.max(FIELD.x + cap.r, anchor.x + (dx / currentDistance) * minimumDistance)
				);
				cap.y = Math.min(
					FIELD.y + FIELD.height - cap.r,
					Math.max(FIELD.y + cap.r, anchor.y + (dy / currentDistance) * minimumDistance)
				);
			}
		}
	}

	function applyFriction(body, dt) {
		const speed = Math.hypot(body.vx, body.vy);
		if (speed <= 0) return;
		const next = Math.max(0, speed - PHYSICS.friction * dt);
		if (next < PHYSICS.restSpeed) {
			body.vx = 0;
			body.vy = 0;
			return;
		}
		body.vx = (body.vx / speed) * next;
		body.vy = (body.vy / speed) * next;
	}

	function collideWalls(body) {
		const inTopGoal =
			body.type === 'ball' && isBallEnteringGoal({ ball: body, pitch: FIELD, goal: GOAL, edge: 'top' });
		const inBottomGoal =
			body.type === 'ball' && isBallEnteringGoal({ ball: body, pitch: FIELD, goal: GOAL, edge: 'bottom' });
		if (body.x - body.r < FIELD.x) {
			body.x = FIELD.x + body.r;
			body.vx = Math.abs(body.vx) * PHYSICS.wallRestitution;
		}
		if (body.x + body.r > FIELD.x + FIELD.width) {
			body.x = FIELD.x + FIELD.width - body.r;
			body.vx = -Math.abs(body.vx) * PHYSICS.wallRestitution;
		}
		if (!inTopGoal && body.y - body.r < FIELD.y) {
			body.y = FIELD.y + body.r;
			body.vy = Math.abs(body.vy) * PHYSICS.wallRestitution;
		}
		if (!inBottomGoal && body.y + body.r > FIELD.y + FIELD.height) {
			body.y = FIELD.y + FIELD.height - body.r;
			body.vy = -Math.abs(body.vy) * PHYSICS.wallRestitution;
		}
	}

	function collideBodies(a, b) {
		const dx = b.x - a.x;
		const dy = b.y - a.y;
		const dist = Math.hypot(dx, dy);
		const minDist = a.r + b.r;
		if (dist <= 0 || dist >= minDist) return;
		const nx = dx / dist;
		const ny = dy / dist;
		const overlap = minDist - dist;
		a.x -= (nx * overlap) / 2;
		a.y -= (ny * overlap) / 2;
		b.x += (nx * overlap) / 2;
		b.y += (ny * overlap) / 2;

		const rvx = b.vx - a.vx;
		const rvy = b.vy - a.vy;
		const speed = rvx * nx + rvy * ny;
		if (speed < 0) {
			if (shouldRecordLastTouch(speed)) {
				if (a === ball && b.type === 'cap') state.lastTouch = b.side;
				if (b === ball && a.type === 'cap') state.lastTouch = a.side;
			}
			const impulse = (-(1 + PHYSICS.restitution) * speed) / (1 / a.mass + 1 / b.mass);
			const ix = impulse * nx;
			const iy = impulse * ny;
			a.vx -= ix / a.mass;
			a.vy -= iy / a.mass;
			b.vx += ix / b.mass;
			b.vy += iy / b.mass;
		}

		if (state.currentShot) {
			if (a === ball || b === ball) state.currentShot.touchedBall = true;
			const owner = getOwner();
			if (a === owner || b === owner) {
				state.currentShot.touchedOwner = true;
				if (
					state.currentShot.side === 'player' &&
					state.ownerHits >= OWNER_LIMITS.vexStart - 1 &&
					!state.currentShot.ownerWarned
				) {
					const cap = state.currentShot.cap;
					const away = normalize({ x: cap.x - owner.x, y: cap.y - owner.y });
					cap.vx += away.x * 420;
					cap.vy += away.y * 420;
					state.currentShot.ownerWarned = true;
					showToast('owner don warn you oo');
				}
			}
			if ((a === ball && b.role === 'keeper') || (b === ball && a.role === 'keeper')) {
				playCommentary('save');
			}
		}
	}

	function checkGoal() {
		if (state.goalCooldown > 0 || state.mode !== 'running') return;
		const left = goalLeft();
		const right = goalRight();
		if (ball.x > left && ball.x < right && ball.y + ball.r < FIELD.y) {
			scoreGoal('player');
		}
		if (ball.x > left && ball.x < right && ball.y - ball.r > FIELD.y + FIELD.height) {
			scoreGoal('cpu');
		}
	}

	function scoreGoal(side) {
		if (side === 'player') {
			state.playerScore += 1;
			state.ownerHits = 0;
		} else {
			state.cpuScore += 1;
		}
		if (state.currentShot) state.currentShot.scored = true;
		flashEl?.classList.remove('is-active');
		void flashEl?.offsetWidth;
		flashEl?.classList.add('is-active');
		spawnParticles(ball.x, ball.y, side === 'player' ? '#E6A817' : '#E5D3F4');
		showToast(side === 'player' ? 'Goal for you!' : 'Computer scores.');
		playCommentary('goal');
		updateHud();
		if (state.playerScore >= GOAL_TARGET || state.cpuScore >= GOAL_TARGET) {
			endGame('goal_target');
			return;
		}
		state.goalCooldown = MATCH_PACING.goalPause;
		resetPositions(side === 'player' ? 'cpu' : 'player');
	}

	function spawnParticles(x, y, color) {
		if (prefersReducedMotion) return;
		for (let i = 0; i < 22; i += 1) {
			const angle = (Math.PI * 2 * i) / 22;
			const speed = randomBetween(90, 260);
			state.particles.push({
				x,
				y,
				vx: Math.cos(angle) * speed,
				vy: Math.sin(angle) * speed,
				life: randomBetween(0.35, 0.8),
				color,
			});
		}
	}

	function updateParticles(dt) {
		for (const particle of state.particles) {
			particle.x += particle.vx * dt;
			particle.y += particle.vy * dt;
			particle.vx *= 0.95;
			particle.vy *= 0.95;
			particle.life -= dt;
		}
		state.particles = state.particles.filter((particle) => particle.life > 0);
	}

	function isSettled() {
		return bodies.every((body) => Math.hypot(body.vx, body.vy) < PHYSICS.restSpeed + 1);
	}

	function draw() {
		ctx.clearRect(0, 0, WORLD.width, WORLD.height);
		drawPitch();
		drawAmbientGlow();
		drawGoals();
		drawParticles();
		for (const cap of cpuCaps) drawCap(cap);
		drawBall();
		for (const cap of playerCaps) drawCap(cap);
		drawAim();
		drawTurnHint();
	}

	function drawPitch() {
		const stripe = ctx.createLinearGradient(0, PITCH.y, 0, PITCH.y + PITCH.height);
		stripe.addColorStop(0, '#24884a');
		stripe.addColorStop(1, '#155c32');
		ctx.fillStyle = stripe;
		roundRect(PITCH.x, PITCH.y, PITCH.width, PITCH.height, 24);
		ctx.fill();

		ctx.save();
		ctx.clip();
		for (let y = PITCH.y; y < PITCH.y + PITCH.height; y += 82) {
			ctx.fillStyle = y / 82 % 2 > 1 ? 'rgba(255,255,255,0.025)' : 'rgba(0,0,0,0.035)';
			ctx.fillRect(PITCH.x, y, PITCH.width, 82);
		}
		ctx.restore();

		ctx.strokeStyle = 'rgba(248,248,250,0.42)';
		ctx.lineWidth = 3;
		roundRect(FIELD.x, FIELD.y, FIELD.width, FIELD.height, 18);
		ctx.stroke();
		ctx.beginPath();
		ctx.moveTo(FIELD.x, PITCH.y + PITCH.height / 2);
		ctx.lineTo(FIELD.x + FIELD.width, PITCH.y + PITCH.height / 2);
		ctx.stroke();
		ctx.beginPath();
		ctx.arc(360, PITCH.y + PITCH.height / 2, 82, 0, Math.PI * 2);
		ctx.stroke();
		drawPenaltyBox('top');
		drawPenaltyBox('bottom');
	}

	function drawPenaltyBox(side) {
		const top = side === 'top' ? PITCH.y + 28 : PITCH.y + PITCH.height - 150;
		ctx.strokeRect(238, top, 244, 122);
		ctx.strokeRect(292, side === 'top' ? PITCH.y + 28 : PITCH.y + PITCH.height - 88, 136, 60);
	}

	function drawAmbientGlow() {
		const owner = getOwner();
		const reaction = ownerReaction(state.ownerHits);
		const intensity = Math.min(state.ownerHits / OWNER_LIMITS.collectAt, 1);
		if (intensity <= 0) return;
		if (reaction.stage === 'warning' || reaction.stage === 'vexed' || reaction.stage === 'collect') {
			const pulse = prefersReducedMotion ? 0.5 : 0.5 + Math.sin(performance.now() / 180) * 0.5;
			const isRed = reaction.tone === 'red';
			ctx.save();
			roundRect(PITCH.x, PITCH.y, PITCH.width, PITCH.height, 24);
			ctx.clip();
			ctx.fillStyle = isRed
				? `rgba(229,57,53,${0.08 + pulse * 0.09})`
				: `rgba(230,168,23,${0.055 + pulse * 0.065})`;
			ctx.fillRect(PITCH.x, PITCH.y, PITCH.width, PITCH.height);
			ctx.restore();
		}
		const glow = ctx.createRadialGradient(owner.x, owner.y, 35, owner.x, owner.y, 360);
		const yellow = reaction.tone !== 'red';
		glow.addColorStop(
			0,
			yellow ? `rgba(230,168,23,${0.2 + intensity * 0.25})` : `rgba(229,57,53,${0.24 + intensity * 0.3})`
		);
		glow.addColorStop(1, 'rgba(0,0,0,0)');
		ctx.fillStyle = glow;
		ctx.fillRect(0, 0, WORLD.width, WORLD.height);
	}

	function drawGoals() {
		ctx.strokeStyle = 'rgba(248,248,250,0.58)';
		ctx.lineWidth = 5;
		ctx.strokeRect(goalLeft(), FIELD.y - GOAL.depth, GOAL.width, GOAL.depth);
		ctx.strokeRect(goalLeft(), FIELD.y + FIELD.height, GOAL.width, GOAL.depth);
	}

	function drawCap(cap) {
		const selected = cap === state.selectedCap;
		ctx.save();
		ctx.shadowColor = selected ? '#FBE9B8' : cap.owner ? ownerGlowColor() : 'rgba(0,0,0,0.36)';
		ctx.shadowBlur = selected ? 24 : cap.owner ? 20 : 10;
		ctx.beginPath();
		ctx.arc(cap.x, cap.y, cap.r, 0, Math.PI * 2);
		ctx.fillStyle = cap.owner ? '#E6A817' : cap.color;
		ctx.fill();
		ctx.lineWidth = cap.owner ? 5 : 4;
		ctx.strokeStyle = cap.side === 'player' ? 'rgba(248,248,250,0.74)' : 'rgba(229,211,244,0.74)';
		ctx.stroke();
		ctx.shadowBlur = 0;
		ctx.fillStyle = cap.owner ? '#171717' : '#F8F8FA';
		ctx.font = '800 20px Open Sans, sans-serif';
		ctx.textAlign = 'center';
		ctx.textBaseline = 'middle';
		ctx.fillText(cap.role === 'keeper' ? 'K' : cap.owner ? 'O' : cap.side === 'player' ? 'Y' : 'C', cap.x, cap.y);
		ctx.restore();
	}

	function drawBall() {
		ctx.save();
		ctx.shadowColor = 'rgba(0,0,0,0.42)';
		ctx.shadowBlur = 10;
		ctx.beginPath();
		ctx.arc(ball.x, ball.y, ball.r, 0, Math.PI * 2);
		ctx.fillStyle = '#F8F8FA';
		ctx.fill();
		ctx.lineWidth = 3;
		ctx.strokeStyle = '#121212';
		ctx.stroke();
		ctx.restore();
	}

	function drawAim() {
		if (!state.dragging || !state.selectedCap || !state.dragPoint) return;
		const cap = state.selectedCap;
		const drag = clampVector({ x: cap.x - state.dragPoint.x, y: cap.y - state.dragPoint.y }, PHYSICS.maxDrag);
		const power = Math.min(1, Math.hypot(drag.x, drag.y) / PHYSICS.maxDrag);
		ctx.save();
		ctx.strokeStyle = '#FBE9B8';
		ctx.lineWidth = 5;
		ctx.lineCap = 'round';
		ctx.setLineDash([12, 10]);
		ctx.beginPath();
		ctx.moveTo(cap.x, cap.y);
		ctx.lineTo(cap.x + drag.x * 1.35, cap.y + drag.y * 1.35);
		ctx.stroke();
		ctx.setLineDash([]);
		ctx.fillStyle = 'rgba(18,18,18,0.8)';
		roundRect(cap.x - 50, cap.y + cap.r + 16, 100, 14, 999);
		ctx.fill();
		ctx.fillStyle = '#F2A900';
		roundRect(cap.x - 48, cap.y + cap.r + 18, 96 * power, 10, 999);
		ctx.fill();
		ctx.restore();
	}

	function drawTurnHint() {
		if (state.mode !== 'running') return;
		ctx.save();
		ctx.fillStyle = 'rgba(18,18,18,0.72)';
		roundRect(238, 462, 244, 42, 999);
		ctx.fill();
		ctx.fillStyle = '#FBE9B8';
		ctx.font = '800 18px Open Sans, sans-serif';
		ctx.textAlign = 'center';
		ctx.textBaseline = 'middle';
		const label = state.turn === 'player' ? 'YOUR FLICK' : state.turn === 'cpu' ? 'CPU THINKING' : 'BALL MOVING';
		ctx.fillText(label, 360, 483);
		ctx.restore();
	}

	function drawParticles() {
		for (const particle of state.particles) {
			ctx.globalAlpha = Math.max(0, particle.life);
			ctx.fillStyle = particle.color;
			ctx.beginPath();
			ctx.arc(particle.x, particle.y, 5, 0, Math.PI * 2);
			ctx.fill();
			ctx.globalAlpha = 1;
		}
	}

	function updateHud() {
		if (playerScoreEl) playerScoreEl.textContent = String(state.playerScore);
		if (cpuScoreEl) cpuScoreEl.textContent = String(state.cpuScore);
		if (timeEl) timeEl.textContent = String(Math.max(0, Math.ceil(state.remaining)));
		if (recordEl) recordEl.textContent = String(state.records.bestStreak);
		if (difficultyPill) difficultyPill.textContent = difficultyLabel();
		if (rulesPill) rulesPill.textContent = rulesLabel();
		if (startButton) startButton.textContent = `Play ${rulesLabel()} · ${difficultyLabel()}`;
		if (turnPill) {
			turnPill.textContent =
				state.turn === 'player' ? 'Your turn' : state.turn === 'cpu' ? 'Computer turn' : 'Ball moving';
		}
		if (ownerPill) {
			const reaction = ownerReaction(state.ownerHits);
			ownerPill.textContent =
				reaction.stage === 'vexed' || reaction.stage === 'collect'
					? 'Owner vexed'
					: reaction.stage === 'warning'
						? 'Owner warning'
						: reaction.stage === 'alert'
							? 'Owner watching'
							: 'Owner calm';
		}
		if (muteButton) muteButton.setAttribute('aria-pressed', String(state.muted));
		if (muteLabel) muteLabel.textContent = state.muted ? 'Muted' : 'Sound on';
	}

	function showToast(message) {
		if (!toastEl) return;
		toastEl.textContent = message;
		toastEl.classList.add('is-visible');
		state.toastTimer = 2.3;
	}

	function readRecords() {
		const fallback = { currentStreak: 0, bestStreak: 0, wins: { easy: 0, medium: 0, hard: 0 }, losses: 0, draws: 0 };
		try {
			const raw = window.localStorage.getItem(RECORDS_KEY);
			if (!raw) return fallback;
			const parsed = JSON.parse(raw);
			return {
				currentStreak: Number(parsed.currentStreak) || 0,
				bestStreak: Number(parsed.bestStreak) || 0,
				wins: {
					easy: Number(parsed.wins?.easy) || 0,
					medium: Number(parsed.wins?.medium) || 0,
					hard: Number(parsed.wins?.hard) || 0,
				},
				losses: Number(parsed.losses) || 0,
				draws: Number(parsed.draws) || 0,
			};
		} catch {
			return fallback;
		}
	}

	function writeRecords(records) {
		try {
			window.localStorage.setItem(RECORDS_KEY, JSON.stringify(records));
		} catch {
			// Private browsing can block storage. Gameplay continues without records.
		}
	}

	function readMuted() {
		try {
			return window.localStorage.getItem(MUTE_KEY) === 'true';
		} catch {
			return false;
		}
	}

	function writeMuted(value) {
		try {
			window.localStorage.setItem(MUTE_KEY, String(value));
		} catch {
			// Ignore storage failures.
		}
	}

	function toggleMute() {
		state.muted = !state.muted;
		writeMuted(state.muted);
		if (state.muted) {
			stopCommentary();
			setAmbienceVolume(0);
		} else {
			setAmbienceVolume(AMBIENCE.volume);
			unlockAudio();
		}
		updateHud();
	}

	function unlockAudio() {
		state.audioReady = true;
		if (!state.muted) startAmbience();
		if ('speechSynthesis' in window) {
			const warmup = new SpeechSynthesisUtterance('');
			warmup.volume = 0;
			window.speechSynthesis.speak(warmup);
		}
	}

	function startAmbience() {
		if (state.muted || state.audio.ambience || state.audio.ambienceAudio) return;
		if (AMBIENCE.url) {
			const audio = new Audio(AMBIENCE.url);
			audio.loop = true;
			audio.volume = AMBIENCE.volume;
			audio.play().catch(() => {});
			state.audio.ambienceAudio = audio;
			return;
		}
		try {
			const AudioContext = window.AudioContext || window.webkitAudioContext;
			if (!AudioContext) return;
			const audioCtx = new AudioContext();
			const bufferSize = audioCtx.sampleRate * 2;
			const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
			const data = buffer.getChannelData(0);
			for (let i = 0; i < bufferSize; i += 1) {
				data[i] = (Math.random() * 2 - 1) * 0.18;
			}
			const noise = audioCtx.createBufferSource();
			noise.buffer = buffer;
			noise.loop = true;
			const filter = audioCtx.createBiquadFilter();
			filter.type = 'lowpass';
			filter.frequency.value = 520;
			const swell = audioCtx.createOscillator();
			swell.type = 'sine';
			swell.frequency.value = 0.07;
			const swellGain = audioCtx.createGain();
			swellGain.gain.value = 0.04;
			const gain = audioCtx.createGain();
			gain.gain.value = AMBIENCE.volume;
			noise.connect(filter);
			filter.connect(gain);
			swell.connect(swellGain);
			swellGain.connect(gain.gain);
			gain.connect(audioCtx.destination);
			noise.start();
			swell.start();
			state.audio.ctx = audioCtx;
			state.audio.ambience = noise;
			state.audio.ambienceGain = gain;
		} catch {
			// Ambience is nice-to-have and should never block play.
		}
	}

	function tickAudio(dt) {
		if (state.audio.duckTimer > 0) {
			state.audio.duckTimer -= dt;
			if (state.audio.duckTimer <= 0 && !state.muted) setAmbienceVolume(AMBIENCE.volume);
		}
	}

	function duckAmbience(seconds = 1.4) {
		state.audio.duckTimer = seconds;
		setAmbienceVolume(0.1);
	}

	function setAmbienceVolume(volume) {
		if (state.audio.ambienceGain) state.audio.ambienceGain.gain.value = volume;
		if (state.audio.ambienceAudio) state.audio.ambienceAudio.volume = volume;
	}

	function playCommentary(eventName) {
		if (state.muted || !state.audioReady) return;
		const item = COMMENTARY[eventName];
		if (!item) return;
		duckAmbience(item.clips.length ? 4.5 : 2.6);
		const priority = [
			'goal',
			'owner_1',
			'owner_2',
			'owner_warn',
			'owner_vex',
			'owner_collect',
			'time_low',
			'full_time',
		];
		const recordedCommentaryPlaying = Boolean(
			state.audio.commentaryAudio && !state.audio.commentaryAudio.paused && !state.audio.commentaryAudio.ended
		);
		if (priority.includes(eventName)) {
			stopCommentary();
		} else if (recordedCommentaryPlaying || ('speechSynthesis' in window && window.speechSynthesis.speaking)) {
			return;
		}
		if (item.clips.length) {
			const audio = new Audio(randomFrom(item.clips));
			audio.volume = 0.9;
			state.audio.commentaryAudio = audio;
			audio.addEventListener('loadedmetadata', () => duckAmbience(audio.duration + 0.45), { once: true });
			let usedFallback = false;
			const fallback = () => {
				if (usedFallback) return;
				usedFallback = true;
				if (state.audio.commentaryAudio === audio) state.audio.commentaryAudio = null;
				speakCommentaryLine(item);
			};
			audio.addEventListener(
				'ended',
				() => {
					if (state.audio.commentaryAudio === audio) state.audio.commentaryAudio = null;
				},
				{ once: true }
			);
			audio.addEventListener('error', fallback, { once: true });
			audio.play().catch(fallback);
			return;
		}
		speakCommentaryLine(item);
	}

	function stopCommentary() {
		if (state.audio.commentaryAudio) {
			state.audio.commentaryAudio.pause();
			state.audio.commentaryAudio.currentTime = 0;
			state.audio.commentaryAudio = null;
		}
		if ('speechSynthesis' in window) window.speechSynthesis.cancel();
	}

	function speakCommentaryLine(item) {
		if (!('speechSynthesis' in window) || !item.lines.length) return;
		const utterance = new SpeechSynthesisUtterance(randomFrom(item.lines));
		utterance.lang = 'en-NG';
		const voices = window.speechSynthesis.getVoices();
		utterance.voice =
			voices.find((voice) => voice.lang.toLowerCase() === 'en-ng') ||
			voices.find((voice) => voice.lang.toLowerCase().startsWith('en-ng')) ||
			null;
		utterance.rate = 1;
		utterance.pitch = 1;
		utterance.volume = 0.95;
		window.speechSynthesis.speak(utterance);
	}

	async function shareResult() {
		const url = new URL('/kanter-ball', window.location.origin).href;
		const text = `I played the computer ${state.playerScore}-${state.cpuScore} on ${rulesLabel()} · ${difficultyLabel()} in Sportykore Kanter Ball. You try: ${url}`;
		track('share_click', currentResultData('share'));
		if (navigator.share) {
			try {
				await navigator.share({ title: 'Sportykore Kanter Ball', text, url });
				return;
			} catch {
				// Fall back if sharing is cancelled or blocked.
			}
		}
		try {
			await navigator.clipboard.writeText(text);
			showToast('Result copied. Opening X...');
		} catch {
			showToast('Opening X...');
		}
		const intent = new URL('https://twitter.com/intent/tweet');
		intent.searchParams.set('text', text);
		window.open(intent.href, '_blank', 'noopener,noreferrer');
	}

	function track(name, data = {}) {
		try {
			if (typeof window.va === 'function') window.va('event', name, data);
			if (typeof window.sportykoreAnalytics?.track === 'function') window.sportykoreAnalytics.track(name, data);
			if (typeof window.analytics?.track === 'function') window.analytics.track(name, data);
			window.dispatchEvent(new CustomEvent('sportykore:kanter-track', { detail: { name, data } }));
		} catch {
			// Analytics must never interrupt play.
		}
	}

	function eventPoint(event) {
		const rect = canvas.getBoundingClientRect();
		return {
			x: ((event.clientX - rect.left) / rect.width) * WORLD.width,
			y: ((event.clientY - rect.top) / rect.height) * WORLD.height,
		};
	}

	function goalLeft() {
		return 360 - GOAL.width / 2;
	}

	function goalRight() {
		return 360 + GOAL.width / 2;
	}

	function getOwner() {
		return cpuCaps.find((cap) => cap.owner) || cpuCaps[3];
	}

	function ownerGlowColor() {
		const reaction = ownerReaction(state.ownerHits);
		if (reaction.tone === 'red') return '#E53935';
		if (reaction.tone === 'yellow') return '#E6A817';
		return 'rgba(251,233,184,0.72)';
	}

	function difficultyLabel() {
		return DIFFICULTIES[state.difficulty].label;
	}

	function rulesLabel() {
		return state.rulesMode === 'football' ? 'Football rules' : 'Street rules';
	}

	function closestTo(items, point) {
		return items.reduce((best, item) => (distance(item, point) < distance(best, point) ? item : best), items[0]);
	}

	function distance(a, b) {
		return Math.hypot(a.x - b.x, a.y - b.y);
	}

	function clamp(value, min, max) {
		return Math.min(max, Math.max(min, value));
	}

	function clampVector(vector, max) {
		const length = Math.hypot(vector.x, vector.y);
		if (length <= max) return vector;
		return { x: (vector.x / length) * max, y: (vector.y / length) * max };
	}

	function normalize(vector) {
		const length = Math.hypot(vector.x, vector.y) || 1;
		return { x: vector.x / length, y: vector.y / length };
	}

	function randomBetween(min, max) {
		return min + Math.random() * (max - min);
	}

	function randomFrom(items) {
		return items[Math.floor(Math.random() * items.length)];
	}

	function roundRect(x, y, width, height, radius) {
		const r = Math.min(radius, width / 2, height / 2);
		ctx.beginPath();
		ctx.moveTo(x + r, y);
		ctx.arcTo(x + width, y, x + width, y + height, r);
		ctx.arcTo(x + width, y + height, x, y + height, r);
		ctx.arcTo(x, y + height, x, y, r);
		ctx.arcTo(x, y, x + width, y, r);
		ctx.closePath();
	}
})();
</script>
