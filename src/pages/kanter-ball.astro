---
import Layout from '../layouts/Layout.astro';

export const prerender = true;

const canonicalUrl = new URL('/kanter-ball', import.meta.env.PUBLIC_SITE_URL ?? 'https://sportykore.com').href;

const gameSchema = {
	'@context': 'https://schema.org',
	'@type': 'VideoGame',
	name: 'Sportykore Kanter Ball',
	description:
		'A mobile-first 7v7 bottle-cap football game from Sportykore. Flick, take turns, beat the computer, and share your result.',
	url: canonicalUrl,
	applicationCategory: 'Game',
	operatingSystem: 'Web browser',
	publisher: {
		'@type': 'Organization',
		name: 'Sportykore',
	},
};
---

<Layout
	title="Sportykore Kanter Ball | 7v7 Bottle-Cap Football Game"
	description="Play Sportykore Kanter Ball, a mobile 7v7 bottle-cap football web demo against the computer. Pick a difficulty, flick your caps, and share the result."
	pathname="/kanter-ball"
	ogImage="/og/og-kanter-ball.png"
	ogImageAlt="Sportykore Kanter Ball bottle-cap football preview with a 0-0 scoreboard and pitch."
	structuredData={[gameSchema]}
>
	<main id="main" class="kanter-page bg-pitch text-white">
		<section class="kanter-hero bg-stripe-hero px-4 pb-7 pt-5 sm:px-8 lg:pb-12 lg:pt-10">
			<div class="mx-auto grid max-w-6xl gap-5 lg:grid-cols-[0.62fr_1.38fr] lg:items-center">
				<div class="kanter-intro">
					<p class="kanter-kicker">Bottle-cap football</p>
					<h1>Kanter Ball</h1>
					<p>Flick seven caps. Beat the computer.</p>
					<div class="kanter-rules-strip" aria-label="Match settings">
						<span>7v7</span>
						<span data-match-length>90s</span>
						<span data-goal-target>First 3</span>
					</div>
				</div>

				<section class="kanter-shell" aria-label="Kanter Ball game">
					<div class="kanter-scorebar" aria-live="polite">
						<div class="kanter-team kanter-team-home">
							<span class="kanter-team-mark" aria-hidden="true">Y</span>
							<span>You</span>
						</div>
						<div class="kanter-scoreline">
							<strong>
								<span data-player-score>0</span>
								<span>–</span>
								<span data-cpu-score>0</span>
							</strong>
							<span><span data-time>90</span>s</span>
						</div>
						<div class="kanter-audio-controls">
							<button class="kanter-icon-button" type="button" data-mute aria-pressed="false" aria-label="Toggle match sounds">
								<svg class="kanter-sound-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M11 5 6 9H3v6h3l5 4V5Z"></path>
									<path d="M15.5 8.5a5 5 0 0 1 0 7"></path>
									<path d="M18.5 5.5a9 9 0 0 1 0 13"></path>
								</svg>
								<svg class="kanter-sound-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M11 5 6 9H3v6h3l5 4V5Z"></path>
									<path d="m16 9 5 5"></path>
									<path d="m21 9-5 5"></path>
								</svg>
							</button>
							<button class="kanter-icon-button" type="button" data-music aria-pressed="false" aria-label="Toggle music">
								<svg class="kanter-music-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M9 18V5l12-2v13"></path>
									<circle cx="6" cy="18" r="3"></circle>
									<circle cx="18" cy="16" r="3"></circle>
								</svg>
								<svg class="kanter-music-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M9 18V5l12-2v13"></path>
									<circle cx="6" cy="18" r="3"></circle>
									<path d="m3 3 18 18"></path>
								</svg>
							</button>
						</div>
						<div class="kanter-team kanter-team-away">
							<span class="kanter-team-mark" aria-hidden="true">C</span>
							<span>CPU</span>
						</div>
					</div>

					<div class="kanter-game-wrap" data-game-wrap>
						<canvas
							id="kanter-canvas"
							class="kanter-canvas"
							width="720"
							height="980"
							aria-label="Top-down Kanter Ball 7v7 pitch"
						></canvas>
						<div class="kanter-toast" data-toast aria-live="polite"></div>
						<div class="kanter-flash" data-flash></div>
						<div class="kanter-goal-banner" data-goal-banner aria-hidden="true">GOAL!</div>

						<div class="kanter-overlay is-visible" data-start-overlay>
							<div class="kanter-overlay-card">
								<p class="kanter-card-kicker">Kanter Ball</p>
								<h2>Set match</h2>
								<div class="kanter-rules" role="group" aria-label="Choose match rules">
									<button type="button" data-rules="football" class="is-active">
										<span>Football</span>
									</button>
									<button type="button" data-rules="street">
										<span>Street</span>
									</button>
								</div>
								<div class="kanter-difficulty" role="group" aria-label="Choose difficulty">
									<button type="button" data-difficulty="easy">Easy</button>
									<button type="button" data-difficulty="medium" class="is-active">Medium</button>
									<button type="button" data-difficulty="hard">Hard</button>
								</div>
								<button type="button" class="btn-cta" data-start>Start match</button>
							</div>
						</div>

						<div class="kanter-overlay" data-end-overlay>
							<div class="kanter-overlay-card">
								<p class="kanter-card-kicker" data-end-kicker>Full time</p>
								<h2 data-end-title>Draw game</h2>
								<p data-end-copy>0-0 on Medium.</p>
								<div class="kanter-end-actions">
									<button type="button" class="btn-cta" data-share>Share result</button>
									<button type="button" class="btn-ghost-dark" data-rematch>Change match</button>
								</div>
								<a
									class="kanter-follow-link"
									href="https://x.com/sportykore"
									target="_blank"
									rel="noopener noreferrer"
									data-follow-x
								>
									Follow Sportykore on X
								</a>
							</div>
						</div>
					</div>
				</section>
			</div>
		</section>
	</main>
</Layout>

<style>
	.kanter-page {
		min-height: 100vh;
		overflow-x: clip;
	}

	.kanter-hero {
		min-height: calc(100vh - 4.5rem);
	}

	.kanter-hero > div,
	.kanter-hero > div > * {
		min-width: 0;
	}

	.kanter-hero h1,
	.kanter-hero p {
		overflow-wrap: anywhere;
	}

	.kanter-intro {
		order: 2;
		max-width: 26rem;
	}

	.kanter-kicker,
	.kanter-card-kicker {
		margin: 0;
		color: var(--gold-soft);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.kanter-intro h1 {
		margin: 0.35rem 0 0;
		font-family: var(--font-playfair);
		font-size: clamp(2.65rem, 2.05rem + 4vw, 5rem);
		font-weight: 850;
		letter-spacing: 0;
		line-height: 0.98;
	}

	.kanter-intro > p:not(.kanter-kicker) {
		margin: 0.9rem 0 0;
		max-width: 18rem;
		color: rgba(248, 248, 250, 0.74);
		font-size: 1.02rem;
		font-weight: 700;
		line-height: 1.45;
	}

	.kanter-rules-strip {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		max-width: 22rem;
		margin-top: 1.2rem;
		border: 1px solid rgba(248, 248, 250, 0.14);
		border-radius: 16px;
		background: rgba(18, 18, 18, 0.54);
		overflow: hidden;
	}

	.kanter-rules-strip span {
		padding: 0.72rem 0.55rem;
		color: rgba(248, 248, 250, 0.76);
		font-size: 0.78rem;
		font-weight: 800;
		text-align: center;
	}

	.kanter-rules-strip span + span {
		border-left: 1px solid rgba(248, 248, 250, 0.12);
	}

	.kanter-shell {
		margin-inline: auto;
		width: min(100%, 39.5rem);
		max-width: 100%;
		min-width: 0;
		order: 1;
		border: 1px solid rgba(248, 248, 250, 0.14);
		border-radius: 18px;
		background:
			linear-gradient(180deg, rgba(44, 12, 84, 0.52), rgba(18, 18, 18, 0.92)),
			repeating-linear-gradient(-45deg, rgba(248, 248, 250, 0.04) 0 1px, transparent 1px 18px);
		box-shadow: var(--shadow-phone);
		padding: 0.7rem;
	}

	.kanter-scorebar {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		gap: 0.75rem;
		border: 1px solid rgba(248, 248, 250, 0.14);
		border-radius: 14px 14px 8px 8px;
		background: rgba(26, 26, 31, 0.94);
		overflow: hidden;
		padding: 0.72rem 0.82rem;
	}

	.kanter-scorebar::after {
		position: absolute;
		inset: auto 0 0;
		height: 1px;
		background: rgba(230, 168, 23, 0.32);
		content: "";
	}

	.kanter-team {
		display: flex;
		min-width: 0;
		align-items: center;
		gap: 0.55rem;
		color: #ffffff;
		font-size: 0.82rem;
		font-weight: 800;
		line-height: 1.1;
	}

	.kanter-team-away {
		justify-content: flex-end;
		color: var(--gold-soft);
		padding-right: 6.35rem;
		text-align: right;
	}

	.kanter-team-mark {
		display: inline-flex;
		width: 2.2rem;
		height: 2.2rem;
		flex: 0 0 auto;
		align-items: center;
		justify-content: center;
		border: 2px solid rgba(248, 248, 250, 0.18);
		border-radius: 999px;
		background: #7a1720;
		color: #ffffff;
		font-size: 0.78rem;
		font-weight: 900;
	}

	.kanter-team-away .kanter-team-mark {
		order: 2;
		border-color: rgba(248, 248, 250, 0.22);
		background: var(--purple);
		color: #ffffff;
	}

	.kanter-scoreline {
		min-width: 0;
		text-align: center;
	}

	.kanter-scoreline strong {
		display: block;
		color: var(--score-gold);
		font-family: var(--font-open-sans);
		font-size: clamp(2rem, 1.42rem + 2.6vw, 2.8rem);
		font-weight: 900;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0;
		line-height: 1;
	}

	.kanter-scoreline > span {
		display: inline-flex;
		margin-top: 0.25rem;
		border-radius: 999px;
		background: rgba(248, 248, 250, 0.08);
		color: var(--gold-soft);
		font-size: 0.72rem;
		font-weight: 800;
		line-height: 1;
		padding: 0.26rem 0.5rem;
	}

	.kanter-audio-controls {
		position: absolute;
		top: 0.7rem;
		right: 0.7rem;
		z-index: 1;
		display: flex;
		gap: 0.35rem;
	}

	.kanter-icon-button {
		display: inline-flex;
		width: 2.25rem;
		height: 2.25rem;
		align-items: center;
		justify-content: center;
		border: 1px solid rgba(248, 248, 250, 0.14);
		border-radius: 999px;
		background: rgba(18, 18, 18, 0.74);
		color: rgba(248, 248, 250, 0.82);
		padding: 0;
	}

	.kanter-icon-button[aria-pressed="true"] {
		color: rgba(248, 248, 250, 0.5);
	}

	.kanter-icon-button svg {
		width: 1.1rem;
		height: 1.1rem;
	}

	.kanter-icon-button .kanter-sound-off,
	.kanter-icon-button .kanter-music-off,
	.kanter-icon-button[aria-pressed="true"] .kanter-sound-on,
	.kanter-icon-button[aria-pressed="true"] .kanter-music-on {
		display: none;
	}

	.kanter-icon-button[aria-pressed="true"] .kanter-sound-off,
	.kanter-icon-button[aria-pressed="true"] .kanter-music-off {
		display: block;
	}

	.kanter-game-wrap {
		position: relative;
		overflow: hidden;
		width: 100%;
		min-width: 0;
		max-width: 100%;
		border: 1px solid rgba(248, 248, 250, 0.18);
		border-radius: 14px;
		background:
			radial-gradient(circle at 50% 0%, rgba(230, 168, 23, 0.14), transparent 22%),
			linear-gradient(180deg, #1e7a40, #14552e);
		box-shadow: 0 18px 46px rgba(0, 0, 0, 0.34);
		touch-action: none;
		user-select: none;
		-webkit-user-select: none;
	}

	.kanter-canvas {
		display: block;
		width: 100%;
		max-width: 100%;
		height: auto;
		aspect-ratio: 36 / 49;
	}

	.kanter-toast {
		position: absolute;
		left: 50%;
		top: 0.85rem;
		z-index: 3;
		max-width: calc(100% - 1.5rem);
		transform: translate(-50%, -0.5rem);
		border: 1px solid rgba(248, 248, 250, 0.16);
		border-radius: 999px;
		background: rgba(18, 18, 18, 0.88);
		color: var(--gold-soft);
		font-size: 0.8rem;
		font-weight: 800;
		opacity: 0;
		padding: 0.5rem 0.8rem;
		pointer-events: none;
		text-align: center;
		transition:
			opacity 0.2s ease,
			transform 0.2s ease;
	}

	.kanter-toast.is-visible {
		opacity: 1;
		transform: translate(-50%, 0);
	}

	.kanter-flash {
		position: absolute;
		inset: 0;
		background: rgba(230, 168, 23, 0.22);
		opacity: 0;
		pointer-events: none;
	}

	.kanter-flash.is-active {
		animation: kanter-flash 0.45s ease-out;
	}

	.kanter-goal-banner {
		position: absolute;
		left: 50%;
		top: 38%;
		z-index: 3;
		transform: translate(-50%, -50%) scale(0.6);
		color: var(--gold-soft);
		font-family: var(--font-playfair);
		font-size: clamp(2.4rem, 1.9rem + 3vw, 4.2rem);
		font-weight: 900;
		letter-spacing: 0.04em;
		text-shadow: 0 4px 22px rgba(0, 0, 0, 0.55);
		opacity: 0;
		pointer-events: none;
	}

	.kanter-goal-banner.is-visible {
		animation: kanter-goal-banner 1.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
	}

	@keyframes kanter-goal-banner {
		0% {
			opacity: 0;
			transform: translate(-50%, -50%) scale(0.6);
		}
		18% {
			opacity: 1;
			transform: translate(-50%, -50%) scale(1.08);
		}
		30% {
			transform: translate(-50%, -50%) scale(1);
		}
		78% {
			opacity: 1;
			transform: translate(-50%, -50%) scale(1);
		}
		100% {
			opacity: 0;
			transform: translate(-50%, -50%) scale(1);
		}
	}

	.kanter-overlay {
		position: absolute;
		inset: 0;
		z-index: 4;
		display: none;
		align-items: center;
		justify-content: center;
		background:
			linear-gradient(180deg, rgba(18, 18, 18, 0.55), rgba(18, 18, 18, 0.82)),
			rgba(18, 18, 18, 0.5);
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 1rem;
		-webkit-overflow-scrolling: touch;
	}

	.kanter-overlay.is-visible {
		display: flex;
	}

	.kanter-overlay-card {
		width: min(100%, 21.5rem);
		border: 1px solid rgba(248, 248, 250, 0.16);
		border-radius: 14px;
		background:
			linear-gradient(180deg, rgba(44, 12, 84, 0.42), rgba(18, 18, 18, 0.96)),
			var(--pitch-black);
		box-shadow: 0 22px 55px rgba(0, 0, 0, 0.38);
		padding: 1rem;
		text-align: left;
	}

	.kanter-overlay-card h2 {
		margin: 0.28rem 0 0.85rem;
		font-family: var(--font-playfair);
		font-size: clamp(2rem, 1.55rem + 2vw, 2.75rem);
		line-height: 1.05;
	}

	.kanter-overlay-card p:not(.kanter-card-kicker) {
		margin: 0 0 1rem;
		color: rgba(248, 248, 250, 0.74);
		line-height: 1.55;
	}

	.kanter-difficulty,
	.kanter-rules {
		display: grid;
		gap: 0.5rem;
		margin: 0 0 0.75rem;
	}

	.kanter-difficulty {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.kanter-rules {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.kanter-difficulty button,
	.kanter-rules button {
		min-height: 2.75rem;
		border: 1px solid rgba(248, 248, 250, 0.18);
		border-radius: 10px;
		background: rgba(248, 248, 250, 0.07);
		color: #ffffff;
		font-size: 0.82rem;
		font-weight: 800;
		padding: 0.58rem 0.5rem;
	}

	.kanter-difficulty button.is-active,
	.kanter-rules button.is-active {
		border-color: var(--cta-gold);
		background: var(--cta-gold);
		color: #171717;
	}

	.kanter-rules button {
		min-height: 3rem;
		line-height: 1.2;
	}

	.kanter-end-actions {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.kanter-follow-link {
		display: inline-block;
		margin-top: 1rem;
		color: var(--gold-soft);
		font-weight: 800;
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}

	@keyframes kanter-flash {
		0% {
			opacity: 0;
		}
		35% {
			opacity: 1;
		}
		100% {
			opacity: 0;
		}
	}

	@media (min-width: 640px) {
		.kanter-overlay {
			align-items: center;
			padding: 1rem;
		}

		.kanter-end-actions {
			flex-direction: row;
			justify-content: center;
		}
	}

	@media (min-width: 1024px) {
		.kanter-intro,
		.kanter-shell {
			order: initial;
		}
	}

	@media (max-width: 639px) {
		.kanter-hero {
			min-height: auto;
		}

		.kanter-intro {
			margin-inline: auto;
			width: 100%;
		}

		.kanter-shell {
			width: calc(100vw - 2rem);
			padding: 0.55rem;
		}

		.kanter-scorebar {
			grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
			gap: 0.45rem;
			padding: 0.62rem;
		}

		.kanter-team {
			gap: 0.35rem;
			font-size: 0.72rem;
		}

		.kanter-team-mark {
			width: 1.8rem;
			height: 1.8rem;
			font-size: 0.68rem;
		}

		.kanter-team-away {
			padding-right: 3.1rem;
		}

		.kanter-scoreline strong {
			font-size: 2.05rem;
		}

		.kanter-overlay-card {
			width: min(100%, 17.6rem);
		}

		.kanter-difficulty button,
		.kanter-rules button {
			font-size: 0.76rem;
			padding-inline: 0.35rem;
		}

		.kanter-rules-strip {
			max-width: none;
		}
	}

	@media (max-width: 380px) {
		.kanter-scorebar {
			gap: 0.3rem;
			padding: 0.55rem;
		}

		.kanter-overlay {
			padding: 0.6rem;
		}

		.kanter-overlay-card {
			padding: 0.8rem;
		}

		.kanter-overlay-card h2 {
			font-size: 1.75rem;
		}

		.kanter-overlay-card p:not(.kanter-card-kicker) {
			margin-bottom: 0.7rem;
			font-size: 0.86rem;
			line-height: 1.35;
		}

		.kanter-difficulty,
		.kanter-rules {
			margin-bottom: 0.65rem;
		}

		.kanter-rules button {
			min-height: 2.7rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.kanter-toast,
		.kanter-flash,
		.kanter-goal-banner,
		.btn-cta,
		.btn-ghost-dark {
			animation: none;
			transition: none;
		}
	}
</style>

<script>
import { analyzeAim, selectionRadius } from '../lib/kanter-ball/aim.js';
import { cpuThinkDelay, planCpuTurn } from '../lib/kanter-ball/cpu.js';
import {
	isBallInKeeperDanger,
	isKeeperRecoveryFlick,
	nextKeeperRecoveryPosition,
} from '../lib/kanter-ball/keeper.js';
import { modeProfile } from '../lib/kanter-ball/modes.js';
import { ownerReaction, OWNER_LIMITS } from '../lib/kanter-ball/owner.js';
import { advanceMatchClock, crossedCountdownThreshold } from '../lib/kanter-ball/pacing.js';
import { collisionGeometry, lastTouchAfterCollision } from '../lib/kanter-ball/physics.js';
import { classifyGoal } from '../lib/kanter-ball/scoring.js';
import {
	detectBoundaryEvent,
	goalKickKeeperPositions,
	insetPitch,
	liveGoalMouthEdge,
	restartPlacement,
	restartClearancePositions,
	resolveCounterWalls,
} from '../lib/kanter-ball/boundaries.js';

(() => {
	const canvas = document.getElementById('kanter-canvas');
	if (!(canvas instanceof HTMLCanvasElement)) return;

	const ctx = canvas.getContext('2d');
	if (!ctx) return;

