---
import Layout from '../layouts/Layout.astro';
import LiveMatchCard from '../components/LiveMatchCard.astro';
import Ticker from '../components/Ticker.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import ContactSection from '../components/ContactSection.astro';
import { homepageFaqEntries } from '../lib/faq';

import matchCenter from '../assets/screens/match-center.png';
import playerProfile from '../assets/screens/player-profile.png';
import manageLeagues from '../assets/screens/manage-leagues.png';
import joinLeague from '../assets/screens/join-league.png';

export const prerender = true;

const steps = [
	{
		title: 'Create your competition',
		text: 'Name it, set the season, add teams.',
	},
	{
		title: 'Invite players by link',
		text: 'Share one link in the team WhatsApp; players build their own profiles.',
	},
	{
		title: 'Run match day live',
		text: 'Score, minute, cards, substitutions, awards, and optional advanced stats from one phone.',
	},
	{
		title: 'The table keeps itself',
		text: 'Standings, team stats, and player profiles update after every result.',
	},
];

const showcase = [
	{
		image: matchCenter,
		alt: 'Sportykore live match center with score buttons, running minute, player events, substitutions, and match stats',
		title: 'Run the match like a broadcast.',
		text: 'Big score buttons, the live minute, scorers, assists, cards, substitutions, man of the match, and optional advanced stats, all from one phone at the pitch.',
	},
	{
		image: playerProfile,
		alt: 'Sportykore player profile showing season stats, career totals, highlights, awards, and player details',
		title: 'Every player gets a record that lasts.',
		text: 'Season numbers, career totals, highlights, and man of the match awards, a record that follows every player.',
	},
	{
		image: manageLeagues,
		alt: 'Sportykore competition management screen for creating, scheduling, and managing competitions',
		title: 'Your competition, in your pocket.',
		text: 'Create the competition, set seasons, add teams, assign team admins, schedule fixtures, and manage match day from your phone.',
	},
	{
		image: joinLeague,
		alt: 'Sportykore join competition screen where a player pastes an invite code',
		title: 'Joining takes one code.',
		text: 'Your admin shares an invite link in the team WhatsApp. Paste the code, build your own profile, and you’re in.',
	},
];

const roles = [
	{
		title: 'Players',
		icon: 'player',
		points: [
			'A permanent profile with goals, assists, fixtures, highlights, awards, and career totals.',
			'Join any competition with one invite code.',
			'Sign in with a one-time code — no passwords, ever.',
		],
		linkLabel: 'More for players',
		href: '/players',
	},
	{
		title: 'Coaches',
		icon: 'coach',
		points: [
			'Formation-aware lineups with proper positions.',
			'Lineups that unlock substitutions and man of the match selection.',
			'Player development tracked from live matches and optional advanced stats.',
		],
		linkLabel: 'More for coaches',
		href: '/players',
	},
	{
		title: 'Organizers',
		icon: 'organizer',
		points: [
			'Create a competition and add teams in minutes.',
			'Assign team admins to handle lineups for their own teams.',
			'Run match day live with standings that update after every result.',
		],
		linkLabel: 'More for organizers',
		href: '/organizers',
	},
];

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://sportykore.com';

const softwareApplicationSchema = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'Sportykore',
	applicationCategory: 'SportsApplication',
	operatingSystem: 'iOS, Android',
	description:
		'Sportykore brings live scoring, automatic standings, team-admin lineups, match stats, and permanent player profiles to grassroots football competitions in Nigeria.',
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'NGN',
	},
	url: siteUrl,
	publisher: {
		'@type': 'Organization',
		name: 'Sportykore',
	},
};
---

<Layout
	title="Grassroots Football Competition Software | Sportykore"
	description="Download Sportykore on the App Store or Google Play. Live scores, automatic standings, match stats, and player profiles for grassroots football."
	pathname="/"
	structuredData={[softwareApplicationSchema]}
>
	<main id="main" class="overflow-x-clip">
		<!-- §5.1 Hero — the signature dark broadcast band -->
		<section class="bg-stripe-hero px-5 pb-16 pt-14 text-white sm:px-8 lg:pb-24 lg:pt-20">
			<div
				class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-x-14 gap-y-10 lg:grid-cols-2"
			>
				<div class="space-y-6">
					<p class="eyebrow hero-enter text-gold-soft" style="--enter-delay: 0ms">
						Looking after the little man
					</p>
					<h1 class="display-1 hero-enter text-balance" style="--enter-delay: 150ms">
						Where local competitions gather.
					</h1>
					<p
						class="hero-enter max-w-lg text-[1.0625rem] leading-relaxed text-white/75"
						style="--enter-delay: 300ms"
					>
						Download Sportykore on the App Store or Google Play. Live scores, standings
						that keep themselves, and player profiles that last.
					</p>
				</div>

				<div class="hero-enter lg:col-start-2 lg:row-span-2 lg:row-start-1" style="--enter-delay: 450ms">
					<div class="mx-auto max-w-md">
						<LiveMatchCard />
					</div>
				</div>

				<div
					class="hero-enter flex flex-col gap-3 sm:flex-row sm:items-center lg:col-start-1"
					style="--enter-delay: 300ms"
				>
					<a href="/download" class="btn-cta text-base">
						Get the app
					</a>
					<a href="#how-it-works" class="btn-ghost-dark text-base">See how it works</a>
				</div>
			</div>
		</section>

		<!-- §5.2 Broadcast ticker (ambience) -->
		<Ticker />

		<!-- Kanter Ball campaign promo -->
		<section class="border-b border-ink/5 bg-chalk px-5 py-14 sm:px-8 lg:py-16">
			<div
				class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-8 lg:grid-cols-[1.05fr_0.95fr]"
				data-reveal
			>
				<div class="max-w-2xl">
					<p class="eyebrow text-purple">New web game</p>
					<h2 class="display-2 mt-3 text-ink">Play Kanter Ball in your browser.</h2>
					<p class="mt-4 leading-relaxed text-muted">
						A quick 7v7 bottle-cap football match from Sportykore. Flick your caps,
						beat the computer, and share the result with the group chat.
					</p>
					<div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
						<a href="/kanter-ball" class="btn-cta text-base">Play Kanter Ball</a>
						<p class="text-sm font-semibold text-muted">No login. Works on mobile.</p>
					</div>
				</div>

				<a
					href="/kanter-ball"
					class="group relative block overflow-hidden rounded-2xl bg-stripe-dark p-4 text-white transition hover:-translate-y-1 hover:shadow-phone"
					aria-label="Play Sportykore Kanter Ball"
				>
					<div class="rounded-[18px] border border-white/15 bg-[#1E7A40] p-4">
						<div class="flex items-center justify-between text-xs font-bold uppercase tracking-[0.08em] text-white/70">
							<span>Kanter Ball</span>
							<span class="text-gold-score">Best 8</span>
						</div>
						<div class="relative mt-4 aspect-[5/3] overflow-hidden rounded-[14px] border-2 border-white/50 bg-[#155C32]">
							<div class="absolute inset-x-0 top-1/2 border-t border-white/45"></div>
							<div class="absolute left-1/2 top-1/2 h-20 w-20 -translate-x-1/2 -translate-y-1/2 rounded-full border border-white/45"></div>
							<div class="absolute left-1/2 top-1 h-7 w-24 -translate-x-1/2 rounded-b-xl border-x-2 border-b-2 border-white/70"></div>
							<div class="absolute bottom-8 left-1/2 h-9 w-9 -translate-x-1/2 rounded-full border-4 border-white/85 bg-[#E53935] shadow-lg"></div>
							<div class="absolute bottom-[46%] left-1/2 h-5 w-5 -translate-x-1/2 rounded-full border-2 border-ink/40 bg-chalk shadow"></div>
							<div class="absolute left-[58%] top-[34%] h-10 w-10 rounded-full border-4 border-white/80 bg-gold-score"></div>
							<div class="absolute left-[42%] top-5 h-10 w-10 rounded-full border-4 border-white/80 bg-purple"></div>
							<div class="absolute bottom-[23%] left-[45%] h-1.5 w-24 origin-left rotate-[-35deg] rounded-full bg-gold-soft/80 transition group-hover:w-32"></div>
						</div>
						<p class="mt-4 text-sm font-bold text-white">
							Take turns. Hit first to 3 before the owner vexes.
						</p>
					</div>
				</a>
			</div>
		</section>

		<!-- §5.3 How it works (light) -->
		<section id="how-it-works" class="scroll-mt-20 bg-chalk px-5 py-20 sm:px-8 lg:py-24">
			<div class="mx-auto max-w-6xl">
				<div class="max-w-2xl" data-reveal>
					<p class="eyebrow text-purple">How it works</p>
					<h2 class="display-2 mt-3 text-ink">From grassroots competition to match-day broadcast in four steps.</h2>
				</div>

				<ol class="mt-12 grid list-none grid-cols-1 gap-6 p-0 sm:grid-cols-2 lg:grid-cols-4">
					{
						steps.map((step, index) => (
							<li data-reveal data-reveal-delay={String(index * 100)}>
								<span class="flex h-10 w-10 items-center justify-center rounded-full bg-purple font-bold text-white">
									{index + 1}
								</span>
								<h3 class="mt-4 text-lg font-bold text-ink">{step.title}</h3>
								<p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">{step.text}</p>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<!-- §5.4 App screens showcase (dark broadcast band) -->
		<section class="bg-stripe-dark px-5 py-20 text-white sm:px-8 lg:py-24">
			<div class="mx-auto max-w-6xl">
				<div class="max-w-2xl" data-reveal>
					<p class="eyebrow text-gold-soft">Inside the app</p>
					<h2 class="display-2 mt-3 text-white">The same chrome, from pitch to phone.</h2>
				</div>

				<div class="mt-14 space-y-20 lg:space-y-24">
					{
						showcase.map((row, index) => (
							<div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">
								<div
									class:list={['flex justify-center', index % 2 === 1 && 'lg:order-2']}
									data-reveal
								>
									<div data-parallax class="w-[70%] max-w-70 sm:max-w-72">
										<PhoneFrame src={row.image} alt={row.alt} />
									</div>
								</div>
								<div
									class:list={[index % 2 === 1 && 'lg:order-1']}
									data-reveal
									data-reveal-delay="100"
								>
									<h3 class="font-display text-2xl font-bold leading-tight sm:text-3xl">
										{row.title}
									</h3>
									<p class="mt-4 max-w-md leading-relaxed text-white/70">{row.text}</p>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- §5.5 For every role (light) -->
		<section class="bg-chalk px-5 py-20 sm:px-8 lg:py-24">
			<div class="mx-auto max-w-6xl">
				<div class="max-w-2xl" data-reveal>
					<p class="eyebrow text-purple">For every role</p>
					<h2 class="display-2 mt-3 text-ink">Built for the whole competition.</h2>
				</div>

				<div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
					{
						roles.map((role, index) => (
							<article
								class="flex flex-col rounded-2xl bg-white p-6 shadow-card sm:p-7"
								data-reveal
								data-reveal-delay={String(index * 100)}
							>
								<span
									class="flex h-11 w-11 items-center justify-center rounded-full bg-purple-tint text-purple"
									aria-hidden="true"
								>
									{role.icon === 'player' && (
										<svg
											class="h-5.5 w-5.5"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<circle cx="12" cy="8" r="4" />
											<path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1" />
										</svg>
									)}
									{role.icon === 'coach' && (
										<svg
											class="h-5.5 w-5.5"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<rect x="4" y="3" width="16" height="18" rx="2" />
											<path d="M9 3v2h6V3" />
											<circle cx="12" cy="11" r="2.5" />
											<path d="M8 17h8" />
										</svg>
									)}
									{role.icon === 'organizer' && (
										<svg
											class="h-5.5 w-5.5"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<path d="M8 21h8" />
											<path d="M12 17v4" />
											<path d="M7 4h10v6a5 5 0 0 1-10 0V4Z" />
											<path d="M7 6H4a2 2 0 0 0 2 4h1" />
											<path d="M17 6h3a2 2 0 0 1-2 4h-1" />
										</svg>
									)}
								</span>
								<h3 class="mt-5 text-xl font-bold text-ink">{role.title}</h3>
								<ul class="mt-4 flex-1 space-y-3 text-[0.9375rem] leading-relaxed text-muted">
									{role.points.map((point) => (
										<li class="flex gap-2.5">
											<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-score" aria-hidden="true" />
											{point}
										</li>
									))}
								</ul>
								<a
									href={role.href}
									class="link-slide mt-6 inline-block self-start font-bold text-purple"
								>
									{role.linkLabel} →
								</a>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<!-- §5.6 FAQ preview (light) -->
		<section class="border-t border-ink/5 bg-chalk px-5 py-20 sm:px-8 lg:py-24">
			<div class="mx-auto max-w-3xl">
				<div class="max-w-2xl" data-reveal>
					<p class="eyebrow text-purple">Questions</p>
					<h2 class="display-2 mt-3 text-ink">Asked and answered.</h2>
				</div>

				<div class="mt-10" data-reveal>
					<FaqAccordion entries={homepageFaqEntries} />
				</div>

				<p class="mt-8" data-reveal>
					<a href="/faq" class="link-slide font-bold text-purple">All questions →</a>
				</p>
			</div>
		</section>

		<ContactSection />
	</main>
</Layout>
